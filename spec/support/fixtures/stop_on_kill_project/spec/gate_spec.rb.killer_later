# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "gate"
require "fileutils"

# Notes that the example ran, and whether it saw the original code or a
# mutant. The baseline runs the original.
def record_run
  state = begin
    yield
  rescue StandardError
    nil
  end
  log = File.expand_path("../tmp/ran.log", __dir__)
  FileUtils.mkdir_p(File.dirname(log))
  File.open(log, "a") { |file| file.puts(state == "open" ? "original" : "mutant") }
end

# The first example is the cheaper one, and kills nothing; the second, which
# takes longer, fails on every mutant of `state`.
RSpec.describe Gate do
  it "is still open" do
    record_run { described_class.new.state }
  end

  it "is open, after a while" do
    sleep 0.05
    expect(described_class.new.state).to eq("open")
  end
end
