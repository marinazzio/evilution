# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "gate"
require "fileutils"

# Each example after the first notes that it ran, and whether it saw the
# original code or a mutant. The baseline runs the original.
def record_run
  state = begin
    yield
  rescue StandardError
    nil
  end
  log = File.expand_path("../tmp/ran.log", __dir__)
  FileUtils.mkdir_p(File.dirname(log))
  File.open(log, "a") { |file| file.puts(state == "open" ? "original" : "mutant") }
end

# The first example fails whatever the code does, so the baseline knows it.
# The second fails on every mutant.
RSpec.describe Gate do
  it "is closed, according to an example that was never right" do
    expect(described_class.new.state).to eq("closed")
  end

  it "is open" do
    expect(described_class.new.state).to eq("open")
  end

  it "is still open" do
    record_run { described_class.new.state }
  end
end
