# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "gate"

# Every mutant fails the first example, then hangs in the second -- past the
# two-second timeout the spec runs with.
RSpec.describe Gate do
  it "is open" do
    expect(described_class.new.state).to eq("open")
  end

  it "answers in time" do
    # Longer than the first example takes even on the original code, so a
    # run that tries its cheapest examples first still comes to this one last.
    sleep 0.05
    state = begin
      described_class.new.state
    rescue StandardError
      nil
    end
    sleep 5 unless state == "open"
  end
end
