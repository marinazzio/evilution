# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "test-unit"
require "gate"
require "fileutils"

# Stands in for the database driver: evilution counts its errors as the test
# infrastructure failing, not as the mutant being caught.
module SQLite3
  class BusyException < StandardError; end
end

# Each test after the first notes that it ran, and whether it saw the
# original code or a mutant. The baseline runs the original.
def record_run
  state = begin
    yield
  rescue StandardError
    nil
  end
  log = File.expand_path("../tmp/ran.log", __dir__)
  FileUtils.mkdir_p(File.dirname(log))
  File.open(log, "a") { |file| file.puts(state == "open" ? "original" : "mutant") }
end

# On every mutant the first test crashes with an infrastructure error and the
# second fails an assertion. The tests run in the order of their names.
class GateTest < Test::Unit::TestCase
  def test_1_reaches_the_database
    state = begin
      Gate.new.state
    rescue StandardError
      nil
    end
    raise SQLite3::BusyException, "database is locked" unless state == "open"
  end

  def test_2_is_open
    assert_equal "open", Gate.new.state
  end

  def test_3_is_still_open
    record_run { Gate.new.state }
  end
end
