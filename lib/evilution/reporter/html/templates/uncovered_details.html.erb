<div class="uncovered-details">
  <h3>Uncovered (<%= uncovered.length %>) — no test executes their line, not run</h3>
  <ul>
    <%- sorted.each do |r| -%>
    <li>
      <span class="operator"><%= h(r.mutation.operator_name) %></span>
      <span class="location"><%= h(r.mutation.file_path) %>:<%= r.mutation.line %></span>
    </li>
    <%- end -%>
  </ul>
</div>
